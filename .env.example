# Copy to `.env` for local development. Never commit real values.
# Production values are created and held in the IPF-owned hosting environment.

# --- Core ---
NODE_ENV=development
PORT=3000
# PostgreSQL (Supabase). Runtime queries use the Transaction Pooler (port 6543).
DATABASE_URL=
# Migrations (`pnpm db:migrate`) use the Session Pooler (port 5432) or a direct connection.
MIGRATION_DATABASE_URL=
# Optional: connections per function instance (1 to 20, default 5).
DATABASE_POOL_MAX=
# Optional PEM of the database server's CA. When set, the runtime connection verifies the server certificate;
# when empty it is encrypted but unverified (Supabase poolers use a private CA that Node does not trust by default).
DATABASE_SSL_CA=
# Generate a fresh random value per environment (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# --- Deployment identity ---
# Public origin (scheme + host, no path) used for emailed links and browser-origin checks. Required in production:
# unset, the deployment's own Vercel address stands in and /api/health reports it missing.
APP_ORIGIN=
# Further accepted production origins, comma-separated (e.g. the www host). Optional.
APP_ALTERNATE_ORIGINS=
# Email address of the permanent Super Admin. Required in production: unset, nobody is Super Admin by email
# (a role stored by `pnpm owner:bootstrap` still counts) and /api/health reports it missing.
OWNER_ADMIN_EMAIL=
# Off Manus: shared secret the host's scheduler sends as `Authorization: Bearer <secret>` to /api/scheduled/*.
# On Manus, scheduled tasks authenticate through the platform and this can stay empty.
CRON_SECRET=

# JUMP programme public forms (registration, portal sign-in link, pricing request, Paystack callbacks). Closed unless 1.
LEGACY_JUMP_ENABLED=

# --- Manus platform (v0.1 host): admin sign-in (OAuth). Replaced when hosting moves off Manus. ---
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
# Manus openId of the Super Admin.
OWNER_OPEN_ID=

# --- Manus platform (v0.1 host): file storage, AI, maps. Replaced when hosting moves off Manus. ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="IP Factory <notifications@contact.ipfactory.co>"
EMAIL_REPLY_TO=info@ipfactory.co
RESEND_WEBHOOK_SECRET=

# --- Google Workspace (Calendar, mailbox fallback and reply sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
JUMP_GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Engagement room files (private Supabase Storage bucket; uploads are off until all three are set) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=engagement-files

# --- Payments ---
# Paystack secret key, required in production (the only way to pay): unset = off, nothing can be paid; sk_test_... = test mode (no real money moves);
# sk_live_... = live. Webhook URL to set in Paystack: <APP_ORIGIN>/api/paystack/webhook. The public key is not needed.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Analytics (optional) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Opt-in database contract tests (`pnpm test:db`): a disposable PostgreSQL database, session/direct connection ---
TEST_DATABASE_URL=

# --- Opt-in live integration tests (set to 1 only with real credentials) ---
VALIDATE_RESEND_CREDENTIALS=
VALIDATE_RESEND_SENDER=
VALIDATE_GOOGLE_CALENDAR=

# Booking page for the free discovery call (a Calendly link is embedded on the result page; other booking apps open in a new tab).
DISCOVERY_CALL_URL=
# Calendly personal access token (secret; Calendly → Integrations → API & Webhooks). Optional: lets the admin
# console show the date and time of calls booked on Calendly. Without it, a booked call shows as "Call requested".
CALENDLY_API_TOKEN=
CALENDLY_SESSION_URL=
